model Expense {
  id String @id @default(uuid()) @db.Uuid

  groupId String    @map("group_id") @db.Uuid
  group   TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title       String   @db.VarChar(200)
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @map("expense_date") @db.Date

  categoryCode    ExpenseCategory    @map("category_code")
  splitMethodCode ExpenseSplitMethod @map("split_method_code")

  paidById String          @map("paid_by_id") @db.Uuid
  paidBy   TripGroupMember @relation("ExpensePaidBy", fields: [paidById], references: [id])

  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("ExpenseCreator", fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shares     ExpenseShare[]
  activities ExpenseActivity[]

  @@index([groupId])
  @@index([categoryCode])
  @@index([paidById])
  @@index([expenseDate])
  @@map("expenses")
}

model ExpenseShare {
  id String @id @default(uuid()) @db.Uuid

  expenseId String  @map("expense_id") @db.Uuid
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  memberId String          @map("member_id") @db.Uuid
  member   TripGroupMember @relation(fields: [memberId], references: [id])

  paidById String          @map("paid_by_id") @db.Uuid
  paidBy   TripGroupMember @relation("SharePaidBy", fields: [paidById], references: [id])

  amount     Decimal  @db.Decimal(12, 2)
  percentage Decimal? @db.Decimal(5, 2)
  shares     Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([expenseId, memberId])
  @@index([memberId])
  @@map("expense_shares")
}

model ExpenseActivity {
  id String @id @default(uuid()) @db.Uuid

  expenseId String  @map("expense_id") @db.Uuid
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  actionCode ExpenseActivityType @map("action_code")

  message   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expenseId])
  @@map("expense_activities")
}

model ExpenseSettlement {
  id String @id @default(uuid()) @db.Uuid

  groupId String    @map("group_id") @db.Uuid
  group   TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  payerMemberId String          @map("payer_member_id") @db.Uuid
  payer         TripGroupMember @relation("SettlementPayer", fields: [payerMemberId], references: [id])

  receiverMemberId String          @map("receiver_member_id") @db.Uuid
  receiver         TripGroupMember @relation("SettlementReceiver", fields: [receiverMemberId], references: [id])

  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  settledAt DateTime @default(now()) @map("settled_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([groupId])
  @@index([payerMemberId])
  @@index([receiverMemberId])
  @@map("expense_settlements")
}

enum ExpenseCategory {
  ACCOMMODATION
  ACTIVITIES
  ENTERTAINMENT
  FOOD
  MEDICAL
  OTHERS
  SHOPPING
  TICKETS
  TRANSPORT
}

enum ExpenseSplitMethod {
  CUSTOM
  EQUAL
  PERCENTAGE
  SHARES
}

enum ExpenseActivityType {
  CREATED
  DELETED
  SETTLED
  UNSETTLED
  UPDATED
}